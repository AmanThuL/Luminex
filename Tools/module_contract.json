{
  "schemaVersion": 1,
  "roots": [
    "Source",
    "RHI",
    "Tests",
    "Tools/TextureBake",
    "Benchmarks"
  ],
  "thirdPartyPrefixes": {
    "SDL3/": "libsdl3"
  },
  "thirdPartyTargets": [
    "ImGui",
    "ImGuiNodeEditor"
  ],
  "budgets": {
    "production": 1000,
    "tests": 1500
  },
  "units": {
    "core": {
      "paths": [
        "Source/Core"
      ],
      "targets": [
        "Core"
      ],
      "units": [],
      "thirdParty": [
        "spdlog",
        "glm"
      ]
    },
    "rhi-public": {
      "paths": [
        "RHI/Include"
      ],
      "targets": [
        "RHI"
      ],
      "units": [],
      "thirdParty": []
    },
    "rhi-impl": {
      "paths": [
        "RHI/Source"
      ],
      "targets": [
        "RHI"
      ],
      "units": [
        "core",
        "rhi-public"
      ],
      "thirdParty": []
    },
    "metal4-backend": {
      "paths": [
        "RHI/Backends/Metal4/Source"
      ],
      "targets": [
        "RHI"
      ],
      "units": [
        "core",
        "rhi-public"
      ],
      "thirdParty": [
        "metal-cpp"
      ]
    },
    "imgui-adapter": {
      "paths": [
        "RHI/Backends/Metal4/ImGui"
      ],
      "targets": [
        "RHIMetal4ImGui"
      ],
      "units": [
        "core",
        "rhi-public",
        "metal4-backend"
      ],
      "thirdParty": [
        "metal-cpp",
        "imgui"
      ]
    },
    "asset": {
      "paths": [
        "Source/Asset"
      ],
      "targets": [
        "Asset"
      ],
      "units": [
        "core"
      ],
      "headers": [
        "RHI/Format.h",
        "RHI/TextureDesc.h"
      ],
      "thirdParty": [
        "glm",
        "cgltf",
        "stb"
      ]
    },
    "render": {
      "paths": [
        "Source/Render"
      ],
      "targets": [
        "Render"
      ],
      "units": [
        "core",
        "rhi-public"
      ],
      "thirdParty": [
        "glm"
      ]
    },
    "scene": {
      "paths": [
        "Source/Scene"
      ],
      "targets": [
        "Scene"
      ],
      "units": [
        "core",
        "rhi-public",
        "asset",
        "render"
      ],
      "thirdParty": [
        "glm"
      ]
    },
    "app-model": {
      "paths": [
        "Source/App/Model"
      ],
      "targets": [
        "AppModel"
      ],
      "units": [
        "core",
        "rhi-public",
        "asset",
        "scene",
        "render"
      ],
      "thirdParty": [
        "glm"
      ],
      "forbidHeaders": [
        "Source/Render/RenderGraph.h"
      ]
    },
    "app-shell": {
      "paths": [
        "Source/App"
      ],
      "targets": [
        "App"
      ],
      "units": [
        "core",
        "rhi-public",
        "rhi-impl",
        "metal4-backend",
        "imgui-adapter",
        "asset",
        "render",
        "scene",
        "app-model"
      ],
      "thirdParty": [
        "glm",
        "imgui",
        "imgui-node-editor",
        "libsdl3"
      ]
    },
    "tests": {
      "paths": [
        "Tests"
      ],
      "targets": [
        "Tests"
      ],
      "units": [
        "core",
        "rhi-public",
        "render",
        "asset",
        "scene",
        "app-model"
      ],
      "thirdParty": [
        "glm",
        "catch2"
      ]
    },
    "texture-bake": {
      "paths": [
        "Tools/TextureBake"
      ],
      "targets": [
        "TextureBake"
      ],
      "units": [
        "core",
        "asset"
      ],
      "thirdParty": [
        "glm",
        "stb"
      ],
      "headers": [
        "RHI/Format.h",
        "RHI/TextureDesc.h"
      ]
    },
    "benchmarks": {
      "paths": [
        "Benchmarks"
      ],
      "targets": [
        "FrameDataBench"
      ],
      "units": [
        "core",
        "rhi-public"
      ],
      "thirdParty": [
        "glm"
      ]
    }
  },
  "targets": {
    "Core": {
      "deps": []
    },
    "RHI": {
      "deps": [
        "Core"
      ]
    },
    "RHIMetal4ImGui": {
      "deps": [
        "Core",
        "RHI",
        "ImGui"
      ]
    },
    "Render": {
      "deps": [
        "Core",
        "RHI"
      ]
    },
    "App": {
      "deps": [
        "Core",
        "RHI",
        "RHIMetal4ImGui",
        "Render",
        "ImGui",
        "ImGuiNodeEditor",
        "Asset",
        "Scene",
        "AppModel"
      ]
    },
    "Tests": {
      "deps": [
        "Core",
        "RHI",
        "Render",
        "Asset",
        "Scene",
        "AppModel"
      ]
    },
    "TextureBake": {
      "deps": [
        "Core",
        "Asset"
      ],
      "frameworks": []
    },
    "FrameDataBench": {
      "deps": [
        "Core",
        "RHI"
      ]
    },
    "Asset": {
      "deps": [
        "Core"
      ],
      "forbidUndefined": "lmx::rhi::"
    },
    "Scene": {
      "deps": [
        "Core",
        "RHI",
        "Asset",
        "Render"
      ]
    },
    "AppModel": {
      "deps": [
        "Core",
        "RHI",
        "Render",
        "Asset",
        "Scene"
      ]
    }
  }
}
