{
  "schemaVersion": 1,
  "roots": [
    "Source",
    "Tests",
    "Tools/TextureBake",
    "Benchmarks"
  ],
  "thirdPartyPrefixes": {
    "SDL3/": "libsdl3"
  },
  "thirdPartyTargets": [
    "ImGui",
    "ImGuiNodeEditor"
  ],
  "budgets": {
    "production": 1000,
    "tests": 1500
  },
  "units": {
    "core": {
      "paths": [
        "Source/Core"
      ],
      "targets": [
        "Core"
      ],
      "units": [],
      "thirdParty": [
        "spdlog",
        "glm"
      ],
      "privateHeaders": []
    },
    "asset": {
      "paths": [
        "Source/Asset"
      ],
      "targets": [
        "Asset"
      ],
      "units": [
        "core"
      ],
      "thirdParty": [
        "glm",
        "cgltf",
        "stb"
      ],
      "privateHeaders": []
    },
    "render": {
      "paths": [
        "Source/Render"
      ],
      "targets": [
        "Render"
      ],
      "units": [
        "core"
      ],
      "thirdParty": [
        "glm"
      ],
      "privateHeaders": [
        "Source/Render/ExposureStage.h",
        "Source/Render/BloomStage.h",
        "Source/Render/DisplayStage.h",
        "Source/Render/RenderGraphInternal.h",
        "Source/Render/TemporalResolveInternal.h"
      ]
    },
    "scene": {
      "paths": [
        "Source/Scene"
      ],
      "targets": [
        "Scene"
      ],
      "units": [
        "core",
        "asset",
        "render"
      ],
      "thirdParty": [
        "glm"
      ],
      "privateHeaders": [
        "Source/Scene/SceneEnvironment.h"
      ]
    },
    "app-model": {
      "paths": [
        "Source/App/Model"
      ],
      "targets": [
        "AppModel"
      ],
      "units": [
        "core",
        "asset",
        "scene",
        "render"
      ],
      "thirdParty": [
        "glm"
      ],
      "forbidHeaders": [
        "Source/Render/RenderGraph.h"
      ],
      "privateHeaders": []
    },
    "app-shell": {
      "paths": [
        "Source/App"
      ],
      "targets": [
        "App"
      ],
      "units": [
        "core",
        "asset",
        "render",
        "scene",
        "app-model"
      ],
      "thirdParty": [
        "glm",
        "imgui",
        "imgui-node-editor",
        "libsdl3"
      ],
      "privateHeaders": [
        "Source/App/EditorShell.h",
        "Source/App/ConsoleLogSink.h",
        "Source/App/Panels/ConsolePanel.h",
        "Source/App/Panels/InspectorPanel.h",
        "Source/App/Panels/PerformancePanel.h",
        "Source/App/Panels/RenderGraphPanel.h",
        "Source/App/Panels/RenderGraphPanelInternal.h",
        "Source/App/Panels/ScenePanel.h",
        "Source/App/Panels/ViewportPanel.h",
        "Source/App/Screenshot.h",
        "Source/App/Panels/ActionFeedback.h",
        "Source/App/Panels/EditorStyle.h",
        "Source/App/Measurement.h"
      ]
    },
    "tests": {
      "paths": [
        "Tests"
      ],
      "targets": [
        "Tests"
      ],
      "units": [
        "core",
        "render",
        "asset",
        "scene",
        "app-model"
      ],
      "thirdParty": [
        "glm",
        "catch2"
      ],
      "privateHeaders": [
        "Tests/BrdfOracle.h",
        "Tests/DisplayTransformOracle.h",
        "Tests/EngineSceneTestSupport.h",
        "Tests/EngineTestSupport.h",
        "Tests/GpuRendererTestSupport.h",
        "Tests/GpuTemporalTestSupport.h",
        "Tests/GpuTestSupport.h",
        "Tests/GraphTestSupport.h",
        "Tests/RenderGraphTestSupport.h"
      ]
    },
    "texture-bake": {
      "paths": [
        "Tools/TextureBake"
      ],
      "targets": [
        "TextureBake"
      ],
      "units": [
        "core",
        "asset"
      ],
      "thirdParty": [
        "glm",
        "stb"
      ],
      "privateHeaders": []
    },
    "benchmarks": {
      "paths": [
        "Benchmarks"
      ],
      "targets": [
        "FrameDataBench"
      ],
      "units": [
        "core"
      ],
      "thirdParty": [
        "glm"
      ],
      "privateHeaders": [
        "Benchmarks/FrameData/DeliverPerDrawData.h",
        "Benchmarks/FrameData/Digest.h",
        "Benchmarks/FrameData/Runner.h",
        "Benchmarks/FrameData/Workload.h"
      ]
    }
  },
  "externals": {
    "rhi": {
      "kind": "external",
      "paths": [
        "RojoRHI"
      ],
      "targets": [
        "RojoRHI",
        "RojoRHIMetal4ImGui",
        "RojoRHITests"
      ],
      "includeRoots": [
        "RojoRHI/Include"
      ],
      "consumers": {
        "asset": [
          "rojoRHI/Format.h",
          "rojoRHI/TextureDesc.h"
        ],
        "render": [
          "*"
        ],
        "scene": [
          "*"
        ],
        "app-model": [
          "*"
        ],
        "app-shell": [
          "*",
          "rojoRHI/Metal4/Metal4ImGui.h"
        ],
        "tests": [
          "*",
          "RojoRHI/Tests/RhiGpuTestSupport.h"
        ],
        "texture-bake": [
          "rojoRHI/Format.h",
          "rojoRHI/TextureDesc.h"
        ],
        "benchmarks": [
          "*"
        ]
      }
    }
  },
  "targets": {
    "Core": {
      "deps": []
    },
    "RojoRHI": {
      "deps": []
    },
    "RojoRHIMetal4ImGui": {
      "deps": [
        "RojoRHI",
        "ImGui"
      ]
    },
    "Render": {
      "deps": [
        "Core",
        "RojoRHI"
      ]
    },
    "App": {
      "deps": [
        "Core",
        "RojoRHI",
        "RojoRHIMetal4ImGui",
        "Render",
        "ImGui",
        "ImGuiNodeEditor",
        "Asset",
        "Scene",
        "AppModel"
      ]
    },
    "Tests": {
      "deps": [
        "Core",
        "RojoRHI",
        "Render",
        "Asset",
        "Scene",
        "AppModel"
      ]
    },
    "RojoRHITests": {
      "deps": [
        "RojoRHI"
      ]
    },
    "TextureBake": {
      "deps": [
        "Core",
        "Asset"
      ],
      "frameworks": []
    },
    "FrameDataBench": {
      "deps": [
        "Core",
        "RojoRHI"
      ]
    },
    "Asset": {
      "deps": [
        "Core"
      ],
      "forbidUndefined": "rojoRHI::"
    },
    "Scene": {
      "deps": [
        "Core",
        "RojoRHI",
        "Asset",
        "Render"
      ]
    },
    "AppModel": {
      "deps": [
        "Core",
        "RojoRHI",
        "Render",
        "Asset",
        "Scene"
      ]
    }
  }
}
