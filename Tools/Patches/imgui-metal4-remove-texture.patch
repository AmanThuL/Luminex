 // renderer backend. Stores the render pipeline state cache and the default
 // font texture, and manages the reusable buffer cache.
 @interface MetalContext : NSObject
+{
+@public
+    // One pending signal value per frame-in-flight slot, sized in Init() alongside
+    // commandAllocators. A single shared counter cannot work here: RenderWindow() signals only the
+    // event of the slot it rendered on, so the next NewFrame(), which runs on a *different* slot,
+    // would wait on a value that slot's event was never signalled with and block forever. A slot
+    // that has never signalled keeps 0, which a fresh shared event already satisfies.
+    std::vector<uint64_t>                                   eventValues;
+}
